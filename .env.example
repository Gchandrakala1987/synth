# Copy to .env (local) or set as environment variables in your deployment.
# The backend reads these via standard ASP.NET Core configuration binding.

# ---- OpenAI ----
# Either standard OpenAI:
OPENAI__APIKEY=sk-replace-me
OPENAI__MODEL=gpt-4o-mini

# ...or Azure OpenAI (uncomment and use instead of OPENAI__*):
# AZUREOPENAI__ENDPOINT=https://<your-resource>.openai.azure.com/
# AZUREOPENAI__APIKEY=replace-me
# AZUREOPENAI__DEPLOYMENT=gpt-4o-mini

# ---- Agent runtime ----
AGENT__MAXSTEPS=25
AGENT__STEPTIMEOUTSECONDS=20
AGENT__HEADLESS=true

# ---- CORS for the React dev server ----
CORS__ALLOWEDORIGINS__0=http://localhost:5173

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:5080
